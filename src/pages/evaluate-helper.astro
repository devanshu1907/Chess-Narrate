---
import { STORIES } from '../data/stories';
---
<!DOCTYPE html>
<html>
<head>
  <title>Stories Evaluator</title>
  <!-- Load Chess.js locally with CommonJS shim -->
  <script is:inline>
    var exports = {};
  </script>
  <script is:inline src="/chess.js"></script>
</head>
<body style="background: #121212; color: #fff; font-family: monospace; padding: 20px; line-height: 1.5;">
  <h1>Chess Stories Evaluator (Stockfish Depth 10)</h1>
  <div id="status" style="font-size: 16px; font-weight: bold; margin-bottom: 20px; color: #0070f3;">Initializing...</div>
  <div id="progress" style="margin-bottom: 20px; background: #333; height: 10px; border-radius: 5px; overflow: hidden; max-width: 600px;">
    <div id="progress-bar" style="background: #0070f3; width: 0%; height: 100%; transition: width 0.1s;"></div>
  </div>
  <pre id="output" style="background: #1e1e1e; padding: 15px; border-radius: 5px; overflow-x: auto; max-height: 500px; font-size: 12px; border: 1px solid #333; white-space: pre-wrap; word-break: break-all;"></pre>
  <button id="copy-btn" style="padding: 10px 20px; font-size: 14px; background: #22c55e; color: white; border: none; cursor: pointer; border-radius: 4px; margin-top: 15px; display: none;">Copy Generated STORIES JSON</button>

  <script is:inline define:vars={{ STORIES }}>
    const SAMPLE_FEN = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";

    const QUALITY_WEIGHTS = {
      brilliant: 100,
      best: 100,
      only_move: 100,
      book: 100,
      excellent: 95,
      good: 80,
      interesting: 75,
      unclear: 70,
      dubious: 50,
      mistake: 30,
      blunder: 0
    };

    function isMoveBook(index, moves) {
      if (index < 0 || index >= moves.length) return false;
      const move = moves[index];
      const standardOpeningMoves = [
        'e4', 'e5', 'Nf3', 'Nc6', 'Bc4', 'Nf6', 'd4', 'exd5', 'Nxd4', 'd5', 'exd5', 'Nxd5',
        'O-O', 'Be7', 'Nc3', 'Nxc3', 'bxc3', 'd6', 'Nf6', 'c5', 'c6', 'g6', 'Bg7', 'Bg2',
        'd4', 'd5', 'c4', 'e6', 'g3', 'Nf6', 'Bg2', 'Be7', 'Nf3', 'O-O', 'b3', 'Bb7',
        'c4', 'c5', 'Nc3', 'Nf6', 'g3', 'g6', 'Bg2', 'Bg7', 'e4', 'd6', 'd3', 'e5',
        'f4', 'exf4', 'Bxf4', 'Be7', 'Nf3', 'Nc6', 'Be2', 'Bg4', 'O-O', 'Bxf3', 'Bxf3',
        'e6', 'd4', 'd5', 'Nc3', 'Nf6', 'Bg5', 'Be7', 'e3', 'O-O', 'Nf3', 'h6', 'Bxf6', 'Bxf6'
      ];
      return index < 10 && standardOpeningMoves.includes(move.san);
    }

    function evaluateFen(worker, fen) {
      return new Promise((resolve) => {
        let bestMove = '';
        let rawScore = 0;
        
        worker.onmessage = (e) => {
          const line = e.data;
          
          const cpMatch = line.match(/score cp (-?\d+)/);
          const mateMatch = line.match(/score mate (-?\d+)/);
          if (cpMatch) {
            rawScore = parseInt(cpMatch[1]);
          } else if (mateMatch) {
            const mateIn = parseInt(mateMatch[1]);
            rawScore = mateIn > 0 ? (10000 - mateIn * 100) : (-10000 - mateIn * 100);
          }
          
          const bestmoveMatch = line.match(/^bestmove\s+(\S+)/);
          if (bestmoveMatch) {
            bestMove = bestmoveMatch[1];
            const activeColor = fen.split(' ')[1] || 'w';
            const normalizedScore = activeColor === 'w' ? rawScore : -rawScore;
            resolve({ score: normalizedScore, bestMove });
          }
        };
        
        worker.postMessage(`position fen ${fen}`);
        worker.postMessage('go depth 10');
      });
    }

    async function run() {
      const statusEl = document.getElementById('status');
      const progressEl = document.getElementById('progress-bar');
      const outputEl = document.getElementById('output');
      const copyBtn = document.getElementById('copy-btn');

      statusEl.textContent = 'Spawning Stockfish Worker...';
      const worker = new Worker('/stockfish.worker.js');

      // Wait for engine to be ready
      await new Promise((resolve) => {
        worker.onmessage = (e) => {
          if (e.data === 'readyok') resolve();
        };
        worker.postMessage('uci');
        worker.postMessage('isready');
      });

      statusEl.textContent = 'Stockfish ready. Beginning evaluations...';

      const results = [];
      let totalMovesProcessed = 0;
      let totalMovesToProcess = 0;

      // Count total moves
      for (const story of STORIES) {
        const chess = new exports.Chess();
        chess.load_pgn(story.pgn);
        totalMovesToProcess += chess.history().length + 1; // +1 for start position
      }

      for (let sIdx = 0; sIdx < STORIES.length; sIdx++) {
        const story = STORIES[sIdx];
        statusEl.textContent = `Analyzing "${story.title}" (${sIdx + 1}/${STORIES.length})...`;

        const chess = new exports.Chess();
        chess.load_pgn(story.pgn);
        const history = chess.history({ verbose: true });
        
        const replay = new exports.Chess();
        const moves = [];
        
        // Starting position FEN
        const loadedFenStart = SAMPLE_FEN;
        const evalCache = {};
        const bestMovesCache = {};

        // Evaluate starting position
        const startResult = await evaluateFen(worker, loadedFenStart);
        evalCache[loadedFenStart] = startResult.score;
        bestMovesCache[loadedFenStart] = startResult.bestMove;
        totalMovesProcessed++;
        progressEl.style.width = `${Math.round((totalMovesProcessed / totalMovesToProcess) * 100)}%`;

        // Evaluate each move FEN
        for (let i = 0; i < history.length; i++) {
          const m = history[i];
          const isOnlyMove = replay.moves().length === 1;
          replay.move(m.san);
          
          const currentFen = replay.fen();
          moves.push({
            san: m.san,
            from: m.from,
            to: m.to,
            piece: m.piece,
            fen: currentFen,
            isOnlyMove
          });

          const result = await evaluateFen(worker, currentFen);
          evalCache[currentFen] = result.score;
          bestMovesCache[currentFen] = result.bestMove;

          totalMovesProcessed++;
          progressEl.style.width = `${Math.round((totalMovesProcessed / totalMovesToProcess) * 100)}%`;
        }

        // Now compute classifications
        const moveClassifications = [];
        const whiteStats = { brilliant: 0, best: 0, excellent: 0, good: 0, book: 0, interesting: 0, dubious: 0, mistake: 0, blunder: 0, only_move: 0, unclear: 0 };
        const blackStats = { brilliant: 0, best: 0, excellent: 0, good: 0, book: 0, interesting: 0, dubious: 0, mistake: 0, blunder: 0, only_move: 0, unclear: 0 };

        moves.forEach((move, idx) => {
          const isWhite = idx % 2 === 0;
          const stats = isWhite ? whiteStats : blackStats;
          
          let quality = 'good';
          if (isMoveBook(idx, moves)) {
            quality = 'book';
          } else {
            const fen_curr = move.fen;
            const fen_prev = idx === 0 ? loadedFenStart : moves[idx - 1].fen;
            const score_curr = evalCache[fen_curr];
            const score_prev = evalCache[fen_prev];
            
            const change = isWhite ? (score_curr - score_prev) : (score_prev - score_curr);
            const bestMove = bestMovesCache[fen_prev];
            const isBestMove = bestMove === (move.from + move.to);
            const isCapture = move.san.includes('x');
            const isCheck = move.san.includes('+') || move.san.includes('#');

            if (move.isOnlyMove) {
              quality = 'only_move';
            } else if (isBestMove && (change >= 100 || (isCapture && change >= 50))) {
              quality = 'brilliant';
            } else if (change <= -200) {
              quality = 'blunder';
            } else if (change <= -80) {
              quality = 'mistake';
            } else if (change <= -50) {
              quality = 'dubious';
            } else if (!isBestMove && (isCheck || isCapture) && change <= -35) {
              quality = 'interesting';
            } else if (Math.abs(score_curr) <= 100 && !isBestMove && change >= -15 && change <= 15) {
              quality = 'unclear';
            } else if (!isBestMove && change >= -15 && change < 0) {
              quality = 'excellent';
            } else if (isBestMove || change >= 0) {
              quality = 'best';
            } else {
              quality = 'good';
            }
          }

          moveClassifications.push(quality);
          stats[quality]++;
        });

        // Calculate Accuracies
        const calculateAccuracy = (color) => {
          let totalWeight = 0;
          let count = 0;
          moves.forEach((_, idx) => {
            const isWhite = idx % 2 === 0;
            if ((color === 'white' && !isWhite) || (color === 'black' && isWhite)) return;
            const quality = moveClassifications[idx];
            totalWeight += QUALITY_WEIGHTS[quality] !== undefined ? QUALITY_WEIGHTS[quality] : 80;
            count++;
          });
          return count > 0 ? Math.round(totalWeight / count) : 100;
        };

        const whiteAccuracy = calculateAccuracy('white');
        const blackAccuracy = calculateAccuracy('black');

        results.push({
          ...story,
          moveClassifications,
          whiteAccuracy,
          blackAccuracy,
          whiteStats,
          blackStats
        });
      }

      statusEl.textContent = 'All evaluations complete! Copy the JSON below.';
      worker.terminate();

      // Format results output as a copy-pasteable TypeScript file content
      const tsCode = `export const STORIES: StoryGame[] = ${JSON.stringify(results, null, 2)};`;
      outputEl.textContent = tsCode;
      
      copyBtn.style.display = 'inline-block';
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(tsCode);
        copyBtn.textContent = 'Copied!';
        setTimeout(() => { copyBtn.textContent = 'Copy Generated STORIES JSON'; }, 2000);
      });
    }

    window.onload = run;
  </script>
</body>
</html>
