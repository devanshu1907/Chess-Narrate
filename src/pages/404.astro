---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="Page Not Found (404) | ChessNarrate" 
	description="Blunder! The page you are looking for does not exist."
>
	<div class="min-h-[60vh] flex flex-col items-center justify-center py-12 px-4 text-center font-sans select-none">
		<div class="max-w-md w-full bg-brand-canvas border border-brand-hairline rounded-lg p-8 shadow-lvl3 relative overflow-hidden">
			<!-- Corner accent grid pattern -->
			<div class="absolute top-0 right-0 w-24 h-24 opacity-[0.03] dark:opacity-[0.07] pointer-events-none" style="background-image: radial-gradient(var(--color-brand-ink) 1px, transparent 0); background-size: 8px 8px;"></div>
			
			<div class="flex flex-col items-center gap-6">
				<!-- Custom Chess Blunder SVG Graphic -->
				<div class="w-24 h-24 text-brand-danger bg-brand-danger-soft/10 dark:bg-brand-danger-soft/5 rounded-full flex items-center justify-center relative shadow-inner">
					<!-- Red exclamation mark / warning indicator overlay -->
					<div class="absolute top-1 right-1 w-6 h-6 bg-brand-danger text-white rounded-full flex items-center justify-center font-bold text-xs border-2 border-brand-canvas animate-pulse">
						??
					</div>
					<!-- Knocked over King/Queen SVG -->
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 transform rotate-[25deg]">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 0 0-3.7-3.7 48.656 48.656 0 0 0-7.324 0 4.006 4.006 0 0 0-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3-3-3M3 12l3-3m-3 3 3 3M19.5 12a2.25 2.25 0 1 1-4.5 0M3 12a2.25 2.25 0 1 1 4.5 0m12 0c0 2.21-3.582 4-8.25 4s-8.25-1.79-8.25-4M12 18.75V21m-4.5-2.25H16.5" />
					</svg>
				</div>

				<div class="flex flex-col gap-2">
					<span class="text-xs font-mono tracking-widest text-brand-danger uppercase font-semibold">
						Error 404
					</span>
					<h1 class="text-3xl font-semibold tracking-tight text-brand-ink">
						Blunder! Illegal Move.
					</h1>
					<p class="text-sm text-brand-body leading-relaxed mt-2">
						The position you navigated to does not exist. Our narrator checked the board twice, but the page was captured or moved.
					</p>
				</div>

				<hr class="w-full border-brand-hairline my-2" />

				<div class="flex flex-col gap-3 w-full">
					<a 
						href="/" 
						class="w-full inline-flex items-center justify-center py-2.5 px-4 text-sm font-medium font-sans text-brand-on-primary bg-brand-primary rounded-pill hover:opacity-90 transition-opacity shadow-lvl2 focus-visible:ring-2 focus-visible:ring-brand-accent cursor-pointer"
					>
						Return to Analysis Board
					</a>
					<a 
						href="/about" 
						class="w-full inline-flex items-center justify-center py-2.5 px-4 text-xs font-mono text-brand-body hover:text-brand-ink hover:underline transition-colors cursor-pointer"
					>
						Learn How ChessNarrate Works
					</a>
				</div>
			</div>
		</div>
	</div>
</Layout>
