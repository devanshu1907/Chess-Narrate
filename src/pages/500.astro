---
import Layout from '../layouts/Layout.astro';

interface Props {
	error: unknown;
}

const { error } = Astro.props;

// Determine if we should show error details (only in development or if a safe error message)
const isDev = import.meta.env.DEV;
const errorMessage = error instanceof Error ? error.message : String(error || 'Unknown error');
const errorStack = error instanceof Error ? error.stack : null;
---

<Layout 
	title="System Blunder (500) | ChessNarrate" 
	description="System Blunder! An unexpected server error occurred."
>
	<div class="min-h-[60vh] flex flex-col items-center justify-center py-12 px-4 text-center font-sans select-none">
		<div class="max-w-md w-full bg-brand-canvas border border-brand-hairline rounded-lg p-8 shadow-lvl3 relative overflow-hidden">
			<!-- Corner accent grid pattern -->
			<div class="absolute top-0 right-0 w-24 h-24 opacity-[0.03] dark:opacity-[0.07] pointer-events-none" style="background-image: radial-gradient(var(--color-brand-ink) 1px, transparent 0); background-size: 8px 8px;"></div>
			
			<div class="flex flex-col items-center gap-6">
				<!-- Custom Chess Crash SVG Graphic -->
				<div class="w-24 h-24 text-brand-warning bg-brand-warning-soft/10 dark:bg-brand-warning-soft/5 rounded-full flex items-center justify-center relative shadow-inner">
					<!-- Warning sign overlay -->
					<div class="absolute top-1 right-1 w-6 h-6 bg-brand-warning text-brand-primary rounded-full flex items-center justify-center font-bold text-xs border-2 border-brand-canvas animate-pulse">
						!
					</div>
					<!-- Broken board / crashed gears SVG -->
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0-10.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.249-8.25-3.286Zm0 13.036h.008v.008H12v-.008Z" />
					</svg>
				</div>

				<div class="flex flex-col gap-2">
					<span class="text-xs font-mono tracking-widest text-brand-warning uppercase font-semibold">
						Error 500
					</span>
					<h1 class="text-3xl font-semibold tracking-tight text-brand-ink">
						System Blunder!
					</h1>
					<p class="text-sm text-brand-body leading-relaxed mt-2">
						The engine encountered a severe positional crash. Castling failed, and our narrator is currently speechless.
					</p>
				</div>

				{error && (
					<div class="w-full text-left bg-brand-canvas-soft2 border border-brand-hairline rounded-sm p-4 text-xs font-mono overflow-x-auto max-h-40">
						<p class="text-brand-danger font-semibold mb-1">Runtime Exception:</p>
						<p class="text-brand-body break-all">{errorMessage}</p>
						{isDev && errorStack && (
							<p class="text-brand-mute mt-2 whitespace-pre text-[10px] leading-normal">{errorStack}</p>
						)}
					</div>
				)}

				<hr class="w-full border-brand-hairline my-2" />

				<div class="flex flex-col gap-3 w-full">
					<a 
						href="/" 
						class="w-full inline-flex items-center justify-center py-2.5 px-4 text-sm font-medium font-sans text-brand-on-primary bg-brand-primary rounded-pill hover:opacity-90 transition-opacity shadow-lvl2 focus-visible:ring-2 focus-visible:ring-brand-accent cursor-pointer"
					>
						Reset & Return Home
					</a>
					<a 
						href="/contact" 
						class="w-full inline-flex items-center justify-center py-2.5 px-4 text-xs font-mono text-brand-body hover:text-brand-ink hover:underline transition-colors cursor-pointer"
					>
						Report this Crash
					</a>
				</div>
			</div>
		</div>
	</div>
</Layout>
